<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@color/neutral_grey">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/verde"
        app:titleTextColor="@color/neutral_grey"
        app:titleCentered="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/app_name" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/song"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintVertical_bias="0.277" />

    <SeekBar
        android:progressTint="@color/verde"
        android:progressBackgroundTint="@color/white"
        android:thumbTint="@color/white"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:layout_marginStart="39dp"
        android:layout_marginEnd="39dp"
        android:layout_marginTop="270dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"

        />

    <ImageButton
        android:id="@+id/btnSkipBack"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="89dp"
        android:layout_marginTop="426dp"
        android:background="@drawable/circle_button"
        android:src="@drawable/ic_skip_previous"
        android:scaleType="centerInside"
        android:contentDescription="@string/song"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnSkipForward"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="272dp"
        android:layout_marginTop="426dp"
        android:background="@drawable/circle_button"
        android:src="@drawable/ic_skip_next"
        android:scaleType="centerInside"
        android:contentDescription="@string/song"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnPlayPausa"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginStart="155dp"
        android:layout_marginTop="399dp"
        android:background="@drawable/circle_button"
        android:src="@drawable/ic_play"
        android:scaleType="centerInside"
        android:contentDescription="@string/song"
        android:text=""
        android:textColor="@color/neutral_grey"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
